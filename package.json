    "sixel": "^0.16.0",
    "speaker": "^0.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
